{
  "name": "hono-idp",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build": "bun build --target=bun --minify --external @node-rs/argon2 src/index.ts --outfile dist/server.js",
    "start": "bun run dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "docker:build": "docker build -t hono-idp ."
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.0",
    "@node-rs/argon2": "^2.0.2",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.55.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/sdk-node": "^0.57.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.19",
    "prom-client": "^15.1.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10"
  },
  "trustedDependencies": [
    "protobufjs"
  ]
}
