    {
      "type": "timeseries",
      "title": "POST /auth/register",
      "id": 10,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "avg(k6_http_req_duration_p50{service=\"go\", scenario=~\"$scenario\", endpoint=\"register\"})",
          "legendFormat": "Go p50",
          "refId": "A"
        },
        {
          "expr": "avg(k6_http_req_duration_p95{service=\"go\", scenario=~\"$scenario\", endpoint=\"register\"})",
          "legendFormat": "Go p95",
          "refId": "B"
        },
        {
          "expr": "avg(k6_http_req_duration_p99{service=\"go\", scenario=~\"$scenario\", endpoint=\"register\"})",
          "legendFormat": "Go p99",
          "refId": "C"
        },
        {
          "expr": "avg(k6_http_req_duration_p50{service=\"bun\", scenario=~\"$scenario\", endpoint=\"register\"})",
          "legendFormat": "Bun p50",
          "refId": "D"
        },
        {
          "expr": "avg(k6_http_req_duration_p95{service=\"bun\", scenario=~\"$scenario\", endpoint=\"register\"})",
          "legendFormat": "Bun p95",
          "refId": "E"
        },
        {
          "expr": "avg(k6_http_req_duration_p99{service=\"bun\", scenario=~\"$scenario\", endpoint=\"register\"})",
          "legendFormat": "Bun p99",
          "refId": "F"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0
          },
          "unit": "s"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "Go.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "Bun.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*p50.*"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dot"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*p99.*"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "min",
            "mean",
            "max"
          ]
        }
      }
    },
